  {
    "compilerOptions": {
      "target": "ESNext",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",

      "rootDir": "./src",
      "outDir": "./dist",

      "strict": true,

      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,

      "skipLibCheck": true,

      "sourceMap": true,

      "types": ["node"]
    },

    "include": ["src"],

    "exclude": [
      "node_modules",
      "dist"
    ]
  }